---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostLayout from '../../layouts/PostLayout.astro';
import PostList from '../../components/PostList.astro';
import { site } from '../../data/site';
import { buildBlogRoutes, getPublishedPosts, renderEntry } from '../../lib/content';

export const getStaticPaths = (async () => {
  const routes = buildBlogRoutes(await getPublishedPosts());
  return [...routes].map(([path, route]) => ({ params: { path: path || undefined }, props: { route } }));
}) satisfies GetStaticPaths;

const { route } = Astro.props;
const Content = route.kind === 'post' ? (await renderEntry(route.post)).Content : undefined;

const archiveTitle =
  route.kind === 'archive'
    ? { year: `Posts from ${route.term}`, tag: `Posts tagged #${route.term}`, category: `Posts in ${route.term}` }[route.type]
    : undefined;
const pagePath = (page: number) => (page === 1 ? '/blog/' : `/blog/page/${page}/`);
---

{route.kind === 'post' && Content && (
  <PostLayout kind="post" {...route.post.data}>
    <Content />
  </PostLayout>
)}
{route.kind === 'index' && (
  <BaseLayout
    title={route.page === 1 ? 'Writing | This is My Pattern' : `Writing, page ${route.page} | This is My Pattern`}
    description={site.blogDescription}
    canonicalPath={pagePath(route.page)}
  >
    <header class="page-header">
      <h1>Writing</h1>
      <p class="lede">{site.blogDescription}</p>
    </header>
    <PostList posts={route.posts} />
    {route.totalPages > 1 && (
      <nav class="pagination" aria-label="Pagination">
        {route.page > 1 && (
          <a href={pagePath(route.page - 1)} rel="prev">
            Newer posts
          </a>
        )}
        <span>
          Page {route.page} of {route.totalPages}
        </span>
        {route.page < route.totalPages && (
          <a href={pagePath(route.page + 1)} rel="next">
            Older posts
          </a>
        )}
      </nav>
    )}
  </BaseLayout>
)}
{route.kind === 'archive' && (
  <BaseLayout title={`${archiveTitle} | This is My Pattern`} canonicalPath={Astro.url.pathname}>
    <header class="page-header">
      <p class="eyebrow">
        <a href="/blog/">Writing</a>
      </p>
      <h1>{archiveTitle}</h1>
    </header>
    <PostList posts={route.posts} />
  </BaseLayout>
)}
