---
import BaseLayout from './BaseLayout.astro';
import ArticleGallery from '../components/ArticleGallery.astro';
import Comments from '../components/Comments.astro';
import { site } from '../data/site';
import { formatDate, isoDate, permalinkYear, slugify } from '../lib/content';

interface Props {
  title: string;
  date: Date;
  permalink: string;
  description?: string;
  tags?: string[];
  categories?: string[];
  giscus_comments?: boolean;
  kind: 'post' | 'news';
}

const { title, date, permalink, description, tags = [], categories = [], giscus_comments = false, kind } = Astro.props;
const year = kind === 'post' ? permalinkYear(permalink) : undefined;
const url = new URL(permalink, Astro.site).href;
const structuredData =
  kind === 'post'
    ? {
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: date.toISOString(),
        url,
        mainEntityOfPage: url,
        keywords: tags.join(', ') || undefined,
        author: { '@type': 'Person', name: site.author, url: new URL('/', Astro.site).href },
      }
    : undefined;
---

<BaseLayout
  title={`${title} | ${site.title}`}
  description={description}
  canonicalPath={permalink}
  type="article"
  publishedTime={date}
  structuredData={structuredData}
>
  <article class="article" data-pagefind-body>
    <header class="article-header">
      <p class="article-meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {kind === 'news' && <span> · Announcement</span>}
      </p>
      <h1>{title}</h1>
      {description && <p class="article-description">{description}</p>}
      {(year || tags.length > 0 || categories.length > 0) && (
        <ul class="article-terms" aria-label="Archives">
          {year && (
            <li>
              <a href={`/blog/${year}/`}>{year}</a>
            </li>
          )}
          {tags.map((tag) => (
            <li>{kind === 'post' ? <a href={`/blog/tag/${slugify(tag)}/`}>#{tag}</a> : <span>#{tag}</span>}</li>
          ))}
          {categories.map((category) => (
            <li>
              <a href={`/blog/category/${slugify(category)}/`}>{category}</a>
            </li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
    <slot name="after" />
    {giscus_comments && <Comments discussionsUrl={site.discussionsUrl} />}
  </article>
  {kind === 'post' && <ArticleGallery />}
</BaseLayout>

<script>
  import '../scripts/article';
</script>
