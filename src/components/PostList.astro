---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate, slugify } from '../lib/content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel: Heading = 'h2' } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-card">
      <p class="post-meta">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
      </p>
      <Heading class="post-title">
        <a href={post.data.permalink}>{post.data.title}</a>
      </Heading>
      {post.data.description && <p class="post-description">{post.data.description}</p>}
      {post.data.tags.length > 0 && (
        <ul class="post-tags" aria-label="Tags">
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/blog/tag/${slugify(tag)}/`}>#{tag}</a>
            </li>
          ))}
        </ul>
      )}
    </li>
  ))}
</ul>
