{
  "name": "thisismypattern",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/copy-assets.mjs && pagefind --site dist",
